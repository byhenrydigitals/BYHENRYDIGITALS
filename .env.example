# GEMINI_API_KEY: Required for Gemini AI API calls if enabled server-side.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_SITE_URL: Canonical public custom domain for SEO tags, sitemap.xml, and robots.txt.
# Set this to your production domain (e.g., https://byhenrydigitals.com or https://byhenrydigitals.pages.dev).
VITE_SITE_URL="https://byhenrydigitals.com"

# PORT: Server listening port (defaults to 3000)
PORT=3000

# CONTACT EMAIL DELIVERY SECRETS (SERVER-SIDE / CLOUDFLARE WORKER SECRETS ONLY)
# Configure ONE of the supported email delivery providers so /api/contact sends emails to byhenrydigitals@gmail.com:
# 1) Resend (Recommended for Cloudflare Pages / Workers):
RESEND_API_KEY=""
# 2) Brevo:
BREVO_API_KEY=""
# 3) SendGrid:
SENDGRID_API_KEY=""
# 4) Mailgun:
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
MAILGUN_BASE_URL=""
# Optional custom verified sender address (e.g., "BYHENRYDIGITALS <no-reply@byhenrydigitals.com>")
CONTACT_FROM_EMAIL=""
# Official recipient defaults to byhenrydigitals@gmail.com
CONTACT_RECIPIENT_EMAIL="byhenrydigitals@gmail.com"

# 5) SMTP (Node / Express server.ts only, e.g., Gmail App Password):
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""

# 6) Optional verified HTTPS webhook relay (must return HTTP 2xx):
CONTACT_WEBHOOK_URL=""
CONTACT_FORWARD_SECRET=""
